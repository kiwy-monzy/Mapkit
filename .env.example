# ── mapkit env template ────────────────────────────────────────────────
# Copy to `.env` (repo root or `mapkit/.env`) and fill in your own keys:
#
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real tokens. The loader
# (`mapkit::grab::load_dotenv`, via the `dotenvy` crate) reads process env
# first, then `.env`, walking up from the current directory, so both the
# CLI (`mapkit-cli`), the standalone server and the embedded game server
# share the same values.

# ── Mapbox (required for grab / tile backfill) ───────────────────────────
# Primary public token (pk.*) from https://account.mapbox.com/access-tokens/
# Used for mapbox-streets-v8 vector tiles + terrain-RGB DEM.
MAPBOX_TOKEN=

# Optional second public token. The grabber round-robins across both keys
# (double rate quota, mutual fallback). This one is URL-restricted in the
# Mapbox dashboard to the chatgpt.com referer — the fetcher sends
# `Referer: https://chatgpt.com/` automatically for it. Leave empty for
# single-key mode.
MAPBOX_TOKEN_2=

# ── Server ───────────────────────────────────────────────────────────────
# Port for `mapkit-server-standalone` / embedded server (default 5150).
MAPKIT_PORT=5150

# Egregoria root override (dir containing assets/collections + tilecache).
# Unset = auto-detect from cwd / executable location.
# MAPKIT_ROOT=

# SQLite registry path override. Unset = <root>/mapkit.db.
# MAPKIT_DB=

# Vite zone-picker build output served at `/`. Unset = <root>/mapkit-web/dist.
# MAPKIT_WEB_DIST=
