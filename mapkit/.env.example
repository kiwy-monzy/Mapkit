# ── mapkit env template (crate-local copy) ─────────────────────────────────
# Same file as the repo-root `.env.example` — kept here so `cargo run -p mapkit`
# from inside `mapkit/` still shows the variables next to the code.
# Canonical source: `<repo>/.env.example`. Copy EITHER to `.env`:
#
#   cp .env.example .env          # from the repo root (preferred), or
#   cp mapkit/.env.example mapkit/.env

# ── Mapbox (required for grab / tile backfill) ───────────────────────────
MAPBOX_TOKEN=
MAPBOX_TOKEN_2=

# ── Server ───────────────────────────────────────────────────────────────
MAPKIT_PORT=5150
# MAPKIT_ROOT=
# MAPKIT_DB=
# MAPKIT_WEB_DIST=
